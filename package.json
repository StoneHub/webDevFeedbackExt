{
  "name": "dev-feedback-capture",
  "private": true,
  "version": "1.8.3",
  "license": "MIT",
  "description": "Turn webpage element notes into a local developer handoff",
  "scripts": {
    "test": "npm run test:extension && npm run test:electron && npm run test:mcp",
    "test:extension": "node --test test/browser-core.test.cjs test/privacy.test.cjs && node test/release.test.cjs",
    "test:electron": "node packages/electron-inspector/scripts/build.cjs && node --test test/electron-inspector.test.cjs",
    "test:mcp": "node --test test/mcp.test.mjs",
    "test:safari": "mkdir -p .build/native-checks && xcrun swiftc -parse-as-library safari/NativeBridge.swift safari/tests/NativeBridgeChecks.swift -o .build/native-checks/checks && .build/native-checks/checks",
    "check": "node scripts/release-check.cjs",
    "package": "node scripts/package-extension.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "safari:preview": "node scripts/safari-preview.cjs",
    "mcp": "node mcp/cli.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=moderate",
    "test:browser": "node test/browser/release-acceptance.mjs",
    "generate:icons": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.63.0",
    "sharp": "0.35.5"
  }
}
